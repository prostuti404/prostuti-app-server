{
    "name": "prostuti-app-backend",
    "version": "1.0.0",
    "organization": "Pixel Peak Solutions Ltd",
    "description": "Backend server for the Prostuti application, built with TypeScript, Express, and MongoDB. This project provides a robust API structure with Zod validation, error handling, and follows best practices for a scalable Node.js backend",
    "main": "server.js",
    "scripts": {
        "build": "tsc && echo \"Build successful!\"",
        "start": "node ./dist/server.js",
        "dev": "cross-env NODE_ENV=development tsx watch ./src/server.ts",
        "staging": "cross-env NODE_ENV=staging tsx watch ./src/server.ts",
        "start:prod": "cross-env NODE_ENV=production node ./dist/server.js",
        "build:dev": "cross-env NODE_ENV=development npm run build",
        "build:staging": "cross-env NODE_ENV=staging npm run build",
        "build:prod": "cross-env NODE_ENV=production npm run build",
        "lint": "eslint src --ignore-path .eslintignore --ext .ts",
        "lint:fix": "npx eslint src --fix",
        "prettier": "prettier --ignore-path .gitignore --write \"./src/**/*.+(js|ts|json)\"",
        "prettier:fix": "npx prettier --write src"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "keywords": [
        "TypeScript",
        "Express",
        "ExpressJS",
        "express.js",
        "mongoose",
        "Zod",
        "Validator",
        "starter",
        "boilerplate"
    ],
    "author": "Pixel Peak",
    "license": "ISC",
    "dependencies": {
        "@types/backblaze-b2": "^1.5.6",
        "@types/bcrypt": "^6.0.0",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.19",
        "@types/express": "^4.17.25",
        "@types/i18n": "^0.13.12",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/mongoose": "^5.11.96",
        "@types/multer": "^2.2.0",
        "@types/node-cron": "^3.0.11",
        "@types/validator": "^13.15.10",
        "backblaze-b2": "^1.7.0",
        "bcrypt": "^5.1.1",
        "cookie-parser": "^1.4.6",
        "cors": "^2.8.5",
        "date-fns": "^4.1.0",
        "dotenv": "^16.4.5",
        "express": "^4.21.1",
        "http-status-codes": "^2.3.0",
        "i18n": "^0.15.1",
        "jsonwebtoken": "^9.0.2",
        "mongoose": "^8.3.2",
        "multer": "^1.4.5-lts.1",
        "node-cron": "^3.0.3",
        "npm": "^10.9.0",
        "socket.io": "^4.8.1",
        "sslcommerz-lts": "^1.1.0",
        "typescript": "^7.0.2",
        "uuid": "^11.0.3",
        "validator": "^13.11.0",
        "winston": "^3.17.0",
        "winston-daily-rotate-file": "^5.0.0",
        "zod": "^3.23.4"
    },
    "devDependencies": {
        "@typescript-eslint/eslint-plugin": "^7.7.1",
        "@typescript-eslint/parser": "^7.18.0",
        "cross-env": "^7.0.3",
        "eslint": "^8.57.1",
        "eslint-config-prettier": "^9.1.0",
        "prettier": "^3.2.5",
        "tsx": "^4.23.13"
    }
}
